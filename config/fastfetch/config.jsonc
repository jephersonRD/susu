// ============================================================================
// ~/.config/fastfetch/config.jsonc — ASCII a la izquierda, datos a la derecha
// Personaliza el arte en ~/.config/fastfetch/logo.txt
// ============================================================================
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": { "top": 1, "left": 1, "right": 3 },
    "color": { "1": "magenta", "2": "blue" }
  },

  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "blue" },
    "size": { "binaryPrefix": "si" },
    "percent": { "type": 3 }
  },

  "modules": [
    {
      "type": "title",
      "key": " ",
      "format": "{user-name}@{host-name}",
      "color": { "user": "magenta", "at": "white", "host": "blue" }
    },
    { "type": "separator", "string": "──────────────────" },
    { "type": "os",       "key": "󰀲  OS",       "format": "{name} {version-id} ({arch})" },
    { "type": "kernel",   "key": "  Kernel" },
    { "type": "uptime",   "key": "  Uptime" },
    { "type": "cpu",      "key": "  CPU" },
    { "type": "gpu",      "key": "  GPU" },
    { "type": "memory",   "key": "󰍛  RAM",      "format": "{used} / {total} ({percentage})" },
    { "type": "battery",  "key": "󰁹  Batería",  "format": "{capacity} ({status})" },
    { "type": "shell",    "key": "  Shell" },
    { "type": "terminal", "key": "  Terminal" },
    { "type": "packages", "key": "󰏖  Paquetes" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
